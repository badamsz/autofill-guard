{
  "name": "autofill-guard",
  "private": true,
  "description": "Chromium extension that blocks autocomplete/autofill on designated sites, manageable by enterprise policy.",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "lint": "node scripts/lint.mjs",
    "templates": "python3 tools/gen_policy_templates.py",
    "templates:check": "python3 tools/gen_policy_templates.py && git diff --exit-code -- policy",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "build": "node scripts/build.mjs",
    "keygen": "node scripts/keygen.mjs"
  },
  "devDependencies": {
    "crx3": "2.0.0",
    "playwright": "1.65.1",
    "yazl": "3.3.1"
  }
}
