{
  "manifest_version": 3,
  "name": "Autofill Guard",
  "short_name": "Autofill Guard",
  "version": "1.0.0",
  "description": "Stop the browser from saving or suggesting autocomplete and autofill data on sites you choose. Manageable by enterprise policy.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "scripting",
    "privacy",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "storage": {
    "managed_schema": "schema.json"
  },
  "action": {
    "default_title": "Autofill Guard",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png"
    }
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
